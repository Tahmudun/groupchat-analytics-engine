# Direct Postgres connection (copy SUPABASE_DB_URL from the root .env)
DATABASE_URL=postgresql://...
# Groq free tier key (copy GROQ_API_KEY from the root .env)
GROQ_API_KEY=gsk_...
OLLAMA_URL=http://localhost:11434
SENTIMENT_ENGINE=auto
# Any long random string; required by /api/v1/* routes
ENGINE_API_TOKEN=
